<Project Sdk="Microsoft.NET.Sdk">

  <!-- Application layer (hexagonal): use cases and the ports they need. The Simulation is the domain. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CultOfComfort.Server.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CultOfComfort.Simulation\CultOfComfort.Simulation.csproj" />
    <ProjectReference Include="..\CultOfComfort.Contracts\CultOfComfort.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CultOfComfort.Server.Tests" />
    <InternalsVisibleTo Include="CultOfComfort.Server" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
