<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The wire and save formats, shared by the Unity client and the server so both read and write the same JSON.
    Plain [Serializable] DTOs with public fields: JsonUtility (client) and System.Text.Json with IncludeFields (server)
    produce the same document. netstandard2.1, like the Simulation, so the DLL drops into Unity's Plugins folder.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>CultOfComfort.Contracts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CultOfComfort.Simulation\CultOfComfort.Simulation.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <UnityPluginDir>$(MSBuildThisFileDirectory)../../client/CultOfComfort.Unity/Assets/Plugins/CultOfComfort.Contracts/</UnityPluginDir>
  </PropertyGroup>

  <Target Name="CopyToUnityClient" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)../../client/CultOfComfort.Unity/Assets')">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)$(TargetName).pdb" DestinationFolder="$(UnityPluginDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
