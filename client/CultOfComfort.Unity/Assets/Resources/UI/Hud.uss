/* Cult of Comfort HUD — layout C on parchment (spec: HUD Kit & Game Frame).
   Units are density-independent points (PanelSettings: constant physical size, 160 dpi).
   Fonts: IM Fell English (world voice), IM Fell English SC (titles), Permanent Marker (the Prophet's voice). */

.hud {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: column;
    justify-content: space-between;
    color: #3a2a18;
    font-size: 14px;
    -unity-font-definition: resource("UI/Fonts/ImFellEnglish");
}

.panel {
    background-image: resource("UI/Kit/parchment");
    -unity-slice-left: 32; -unity-slice-right: 32; -unity-slice-top: 32; -unity-slice-bottom: 32;
    -unity-slice-scale: 0.5px;
    padding: 12px 16px;
}

.hidden { display: none; }
.spacer { flex-grow: 1; }
.small { font-size: 11px; color: #6b5a44; }
.icon { width: 22px; height: 22px; -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }

.icon-timber { background-image: resource("UI/Icons/timber"); }
.icon-scrap { background-image: resource("UI/Icons/scrap"); }
.icon-peat { background-image: resource("UI/Icons/peat"); }
.icon-devotion { background-image: resource("UI/Icons/devotion"); }
.icon-penny { background-image: resource("UI/Icons/penny"); }
.icon-comfort { background-image: resource("UI/Icons/comfort"); }
.icon-sluice { background-image: resource("UI/Icons/sluice"); }
.icon-voice { background-image: resource("UI/Icons/voice"); }
.icon-stones { background-image: resource("UI/Icons/stones"); }
.icon-laser { background-image: resource("UI/Icons/laser"); }
.icon-torch { background-image: resource("UI/Icons/torch"); }
.icon-magnifier { background-image: resource("UI/Icons/magnifier"); }
.icon-speed { background-image: resource("UI/Icons/speed"); }
.icon-map { background-image: resource("UI/Icons/map"); }
.icon-research { background-image: resource("UI/Icons/research"); }
.icon-missionaries { background-image: resource("UI/Icons/missionaries"); }
.icon-tithes { background-image: resource("UI/Icons/tithes"); }
.icon-shop { background-image: resource("UI/Icons/shop"); }
.icon-cult { background-image: resource("UI/Icons/cult"); }
.icon-settings { background-image: resource("UI/Icons/settings"); }
.icon-portrait_prophet { background-image: resource("UI/Icons/portrait_prophet"); }

/* ---------- frame ---------- */

.top { flex-direction: column; }
.frame { flex-direction: column; }
.pills { flex-direction: row; flex-wrap: wrap; }

.pill, .pill-note {
    flex-direction: row; align-items: center;
    height: 28px; padding: 0 9px 0 4px; margin: 0 5px 5px 0;
    background-image: resource("UI/Kit/parchment_dark");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24; -unity-slice-scale: 0.5px;
}
.pill-note {
    background-image: resource("UI/Kit/note_yellow");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
    rotate: 2deg;
}
.pill-value { color: #f6e7c4; -unity-font-style: bold; font-size: 13px; margin-left: 3px; padding: 0; }
.pill-note .pill-value { color: #2b2215; -unity-font-definition: resource("UI/Fonts/PermanentMarker"); }
.demo-tag {
    display: none; font-size: 8px; color: #ffcf80; margin-left: 3px; padding: 0;
    -unity-font-definition: resource("UI/Fonts/PermanentMarker");
}
.demo > .demo-tag { display: flex; }
.pill-note.demo > .demo-tag { color: #a8432c; }

.identity { flex-direction: row; align-items: center; margin-top: 2px; }
.avatar {
    width: 58px; height: 58px; border-radius: 29px;
    background-color: #6d4c2f; border-color: #d9b45a; border-width: 3px;
}
.avatar-clip { flex-grow: 1; border-radius: 26px; overflow: hidden; }
.portrait-face { width: 100%; height: 100%; }
.hearth-badge {
    position: absolute; right: -2px; bottom: -2px;
    width: 24px; height: 24px; border-radius: 12px;
    background-color: #7a1f1a; border-color: #e3b34a; border-width: 2px;
    color: #ffd98a; font-size: 13px; -unity-text-align: middle-center; padding: 0;
    -unity-font-definition: resource("UI/Fonts/ImFellEnglishSC");
}
.id-label {
    margin-left: 8px; padding: 6px 12px 6px 12px;
    background-image: resource("UI/Kit/parchment");
    -unity-slice-left: 32; -unity-slice-right: 32; -unity-slice-top: 32; -unity-slice-bottom: 32; -unity-slice-scale: 0.5px;
}
.tape {
    position: absolute; top: -8px; left: 22px; width: 46px; height: 14px; rotate: -8deg;
    background-image: resource("UI/Kit/tape_a");
}
.id-title { -unity-font-definition: resource("UI/Fonts/ImFellEnglishSC"); font-size: 14px; padding: 0; margin: 0; }
.id-line { font-size: 12px; padding: 0; margin: 0; }
.id-line.demo { color: #8a6a47; }

.round {
    width: 48px; height: 48px; border-radius: 24px; padding: 6px; margin: 0;
    background-image: resource("UI/Kit/parchment");
    -unity-slice-left: 32; -unity-slice-right: 32; -unity-slice-top: 32; -unity-slice-bottom: 32; -unity-slice-scale: 0.5px;
    border-width: 0; align-items: center; justify-content: center;
}
.round > .icon { width: 34px; height: 34px; }

/* ---------- strips ---------- */

.strip { margin: 8px -16px 0 -16px; rotate: -1.5deg; }
.hazard-track {
    height: 20px;
    background-image: resource("UI/Kit/hazard"); background-repeat: repeat; background-size: 32px 32px;
    border-color: #222; border-top-width: 2px; border-bottom-width: 2px;
}
.hazard-cover { position: absolute; right: 0; top: 0; bottom: 0; background-color: rgba(30, 26, 20, 0.72); }
.marker-note, .wave-label {
    -unity-font-definition: resource("UI/Fonts/PermanentMarker");
    color: #ffe066; font-size: 14px; margin: 2px 24px 0 24px; padding: 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}
.meter { flex-direction: row; align-items: center; margin: 3px 24px 0 24px; }
.meter-label { width: 60px; color: #f6e7c4; -unity-font-definition: resource("UI/Fonts/ImFellEnglishSC"); font-size: 13px; padding: 0; text-shadow: 0 1px 2px rgba(0,0,0,0.9); }
.meter-track { flex-grow: 1; height: 14px; background-color: rgba(30, 26, 20, 0.8); border-color: #222; border-width: 2px; }
.meter-fill { height: 100%; background-image: resource("UI/Kit/hazard"); background-repeat: repeat; background-size: 24px 24px; }
.meter-value { width: 36px; color: #f6e7c4; font-size: 12px; -unity-text-align: middle-right; padding: 0; }

/* ---------- middle ---------- */

.middle { flex-grow: 1; flex-direction: row; justify-content: space-between; align-items: flex-start; margin-top: 10px; }
.side { flex-direction: column; }
.shortcut { align-items: center; margin-bottom: 10px; }
.shortcut-label { font-size: 10px; color: #fff3d6; text-shadow: 0 1px 2px #000; padding: 0; margin-top: 2px; }
.locked > .icon { opacity: 0.55; }
.padlock { position: absolute; right: -2px; bottom: -2px; width: 18px; height: 18px; background-image: resource("UI/Kit/padlock"); }

.centre { flex-grow: 1; flex-shrink: 1; align-items: center; padding: 0 8px; }
.toast {
    max-width: 92%; margin-top: 4px; padding: 8px 18px; white-space: normal; -unity-text-align: middle-center;
    background-image: resource("UI/Kit/parchment");
    -unity-slice-left: 32; -unity-slice-right: 32; -unity-slice-top: 32; -unity-slice-bottom: 32; -unity-slice-scale: 0.5px;
}
.toast.prophet, .locked-note {
    background-image: resource("UI/Kit/note_yellow");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
    -unity-font-definition: resource("UI/Fonts/PermanentMarker");
    color: #2b2215; rotate: -1.5deg;
}
.locked-note {
    width: 78%; /* a fixed width: with only max-width, wrapped text is measured too short and spills out */ margin-top: 10px; padding: 14px 16px; white-space: normal; font-size: 14px;
    background-image: resource("UI/Kit/note_pink");
    rotate: 2deg;
}

.sheet { position: absolute; top: 18%; width: 260px; align-self: center; align-items: stretch; }
.sheet-title, .card-title { -unity-font-definition: resource("UI/Fonts/ImFellEnglishSC"); color: #7a1f1a; font-size: 22px; margin: 0 0 6px 0; padding: 0; white-space: normal; }
.sheet-line, .card-line { white-space: normal; margin: 3px 0 0 0; padding: 0; }

.card { position: absolute; width: 90%; max-width: 440px; align-self: center; align-items: stretch; }
.portrait .card { top: 22%; }
.landscape .card { top: 3%; padding: 8px 16px; }
.landscape .card .card-title { font-size: 18px; margin-bottom: 2px; }
.landscape .stamp { height: 44px; margin: 2px 0; }
.landscape .frame { flex-direction: row; align-items: center; }
.landscape .pills { flex-grow: 1; }
.stamp { height: 74px; margin: 8px 0; -unity-background-scale-mode: scale-to-fit; }
.stamp.verified { background-image: resource("UI/Kit/stamp_verified"); }
.stamp.mismatch { background-image: resource("UI/Kit/stamp_mismatch"); }

/* ---------- buttons ---------- */

.btn { margin: 0; border-width: 0; background-color: rgba(0, 0, 0, 0); color: #2b2215; }
.primary {
    height: 50px; padding: 0 18px; border-radius: 12px;
    background-color: #c97a2c; border-color: #6b3a12; border-width: 2px;
    color: #fff4dc; font-size: 20px; -unity-font-definition: resource("UI/Fonts/ImFellEnglishSC");
    text-shadow: 0 1px 0 #6b3a12;
}
.primary:hover { background-color: #d98a38; }
.primary:active { background-color: #a9621f; }
.plain { height: 36px; margin-top: 8px; border-radius: 8px; background-color: rgba(122, 31, 26, 0.12); border-color: #8a6a3a; border-width: 1px; font-size: 15px; }

.note-yellow, .note-pink, .note-green, .note-blue {
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16;
    -unity-font-definition: resource("UI/Fonts/PermanentMarker");
}
.note-yellow { background-image: resource("UI/Kit/note_yellow"); }
.note-pink { background-image: resource("UI/Kit/note_pink"); }
.note-green { background-image: resource("UI/Kit/note_green"); }
.note-blue { background-image: resource("UI/Kit/note_blue"); }

/* ---------- bottom bar ---------- */

.bar {
    background-image: resource("UI/Kit/parchment_dark");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24; -unity-slice-scale: 0.5px;
    padding: 10px 12px;
}
.dusk-bar, .night-bar { flex-direction: column; }
.landscape .dusk-bar { flex-direction: row; align-items: center; }
.tilt-left { rotate: -2deg; }
.tilt-right { rotate: 2deg; }
.actions { flex-direction: row; align-items: center; flex-grow: 1; }
.actions > .primary { flex-grow: 1; margin: 0 8px; }
.bar-shortcut { margin-bottom: 0; }
.bar-shortcut .shortcut-label { color: #f6e7c4; }

.skills { flex-direction: row; }
.skill { flex-grow: 1; height: 62px; margin-right: 8px; padding: 4px; align-items: center; justify-content: center; }
.skill:disabled { opacity: 0.55; }
.skill.aiming { scale: 1.08 1.08; border-color: #ff5a00; border-width: 3px; }
.skill-icon { width: 30px; height: 30px; }
.skill-text { font-size: 12px; padding: 0; -unity-text-align: middle-center; white-space: normal; }
.speed { flex-grow: 0; width: 64px; margin-right: 0; }
.hint { color: #f6e7c4; font-size: 12px; white-space: normal; margin-top: 6px; padding: 0; }

/* ---------- floating notes over raiders ---------- */

.floater {
    position: absolute; width: 80px; -unity-text-align: middle-center; padding: 0;
    -unity-font-definition: resource("UI/Fonts/PermanentMarker");
    color: #ffe066; font-size: 15px; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.95);
}

/* ---------- village: build drawer ---------- */

.drawer { height: 116px; flex-grow: 1; flex-shrink: 1; }
.portrait .drawer { margin-bottom: 8px; }
.build-card { width: 100px; height: 108px; margin-right: 8px; padding: 4px 4px 8px 4px; align-items: center; justify-content: flex-start; }
.card-icon { width: 36px; height: 36px; flex-shrink: 0; }
.card-name { font-size: 10px; padding: 0; -unity-text-align: middle-center; white-space: normal; }
.card-cost { font-size: 9px; padding: 0; color: #5a3d1e; -unity-text-align: middle-center; white-space: normal; }
.card-time { position: absolute; top: 7px; left: 12px; font-size: 9px; padding: 0; color: #5a3d1e; }
.card-size { position: absolute; top: 20px; left: 12px; font-size: 9px; color: #5a3d1e; padding: 0; -unity-font-style: bold; }
.card-lock { display: none; position: absolute; top: 7px; right: 12px; font-size: 9px; color: #a8322a; padding: 0; }
.build-card.locked { opacity: 0.6; }
.build-card.locked > .card-lock { display: flex; }
.build-card.locked > .card-time { display: none; }
.build-card.unaffordable .card-cost { color: #a8322a; }
.build-card.selected { scale: 1.06 1.06; border-color: #c9862e; border-width: 3px; }
.icon-b_hearth { background-image: resource("UI/Icons/b_hearth"); }
.icon-b_woodcutter { background-image: resource("UI/Icons/b_woodcutter"); }
.icon-b_peat_cut { background-image: resource("UI/Icons/b_peat_cut"); }
.icon-b_storage_hut { background-image: resource("UI/Icons/b_storage_hut"); }
.icon-b_cultist_hut { background-image: resource("UI/Icons/b_cultist_hut"); }
.icon-b_cistern { background-image: resource("UI/Icons/b_cistern"); }
.icon-b_slurry_chute { background-image: resource("UI/Icons/b_slurry_chute"); }
.icon-b_sapling_flinger { background-image: resource("UI/Icons/b_sapling_flinger"); }

/* landscape is short: a compact drawer so the board keeps most of the screen */
.landscape .drawer { height: 78px; }
.landscape .build-card { width: 84px; height: 72px; padding: 2px 3px 4px 3px; }
.landscape .card-icon { width: 26px; height: 26px; }
.landscape .card-name { font-size: 9px; }
.landscape .card-cost { font-size: 8px; }
.landscape .bar { padding: 6px 10px; }
.landscape .primary { height: 44px; }
.sheet .sheet-title { white-space: normal; font-size: 19px; }
.icon-b_wattle_fence { background-image: resource("UI/Icons/b_wattle_fence"); }

/* landscape: the settings sheet (with dev buttons) stays clear of the night bar */
.landscape .sheet { top: 2%; padding: 6px 12px; }
.landscape .sheet .plain { height: 26px; margin-top: 3px; font-size: 13px; }
.landscape .sheet .sheet-title { font-size: 16px; margin-bottom: 2px; }
.landscape .sheet .sheet-line { font-size: 11px; margin-top: 1px; }
.icon-b_stone { background-image: resource("UI/Icons/b_stone"); }
.icon-b_tree { background-image: resource("UI/Icons/b_tree"); }
.rotate-button { position: absolute; right: 8px; top: -58px; width: 104px; height: 46px; font-size: 16px; background-color: #efe2c0; border-color: #6d4c2f; border-width: 3px; border-radius: 8px; color: #3b2614; -unity-font-style: bold; }
.icon-b_wooden_wall { background-image: resource("UI/Icons/b_wooden_wall"); }
.icon-b_gate { background-image: resource("UI/Icons/b_gate"); }
.icon-b_dirt_track { background-image: resource("UI/Icons/b_dirt_track"); }
.icon-b_plank_walk { background-image: resource("UI/Icons/b_plank_walk"); }
.icon-b_cobbled_road { background-image: resource("UI/Icons/b_cobbled_road"); }
.icon-b_cottage { background-image: resource("UI/Icons/b_cottage"); }
.icon-b_midden_sorter { background-image: resource("UI/Icons/b_midden_sorter"); }
.icon-b_bathhouse { background-image: resource("UI/Icons/b_bathhouse"); }
.pill.cold, .pill-note.cold { background-color: #9fc7d9; }
.pill.cold .pill-value, .pill-note.cold .pill-value { color: #1d4a66; }
.repair-all-button { position: absolute; left: 8px; top: -58px; height: 46px; font-size: 15px; padding: 0 14px; background-color: #efe2c0; border-color: #6d4c2f; border-width: 3px; border-radius: 8px; color: #3b2614; -unity-font-style: bold; }
.ghost-actions { position: absolute; flex-direction: column; }
.ghost-row { flex-direction: row; }
.ghost-button { width: 50px; height: 50px; margin-right: 6px; font-size: 26px; border-radius: 25px; border-width: 3px; border-color: #6d4c2f; background-color: #efe2c0; color: #3b2614; -unity-font-style: bold; padding: 0; }
.ghost-confirm { background-color: #7fb069; color: #ffffff; }
.ghost-confirm:disabled { background-color: #9a9a8a; opacity: 0.7; }
.ghost-cancel { background-color: #c75b4a; color: #ffffff; }
.ghost-problem { margin-top: 4px; max-width: 200px; white-space: normal; font-size: 12px; color: #fff4dc; background-color: rgba(60, 30, 20, 0.85); border-radius: 6px; padding: 3px 6px; }
.bubble { position: absolute; max-width: 160px; white-space: normal; font-size: 13px; color: #2b2215; background-color: #fffaf0; border-color: #3b2614; border-width: 2px; border-radius: 10px; padding: 4px 8px; -unity-text-align: middle-center; }
.ghost-turn { width: 70px; font-size: 16px; }

/* ---------- the Prophet's errand (spec 2026-10-13 first-hour arc) ---------- */
.errand-note {
    width: 62%; margin: 2px 0 0 0; padding: 6px 10px 8px 10px; align-items: flex-start; rotate: -1deg; /* compact: the board stays visible */
    color: #2b2215; border-width: 0; background-color: rgba(0, 0, 0, 0);
}
.errand-heading { font-size: 9px; color: #7a5a2a; padding: 0; margin: 0; }
.errand-text { font-size: 12px; white-space: normal; padding: 0; margin: 1px 0 0 0; -unity-text-align: upper-left; }
.errand-reward { font-size: 10px; color: #5b6b2a; padding: 0; margin: 2px 0 0 0; }
.errand-claim {
    display: none; position: absolute; right: 6px; bottom: 4px; padding: 1px 6px; font-size: 12px; rotate: -6deg;
    color: #2f7a35; border-width: 2px; border-color: #2f7a35; border-radius: 4px;
    -unity-font-definition: resource("UI/Fonts/ImFellEnglishSC");
}
.errand-note.done { rotate: 1deg; }
.hinted { border-width: 3px; border-color: #ffd34d; }
.primary.waiting { opacity: 0.55; font-size: 14px; }

/* ---------- the tutorial coach (GDD 05) ---------- */
.coach-arrow { position: absolute; width: 34px; height: 40px; transform-origin: center; }
.coach-line {
    position: absolute; max-width: 230px; padding: 6px 10px 8px 10px; font-size: 13px; color: #2b2215; white-space: normal;
    -unity-text-align: middle-center; rotate: -1deg;
}

/* ---------- relics from the boot (GDD 05) ---------- */
.relics { flex-direction: row; margin-bottom: 6px; }
.relic { height: 54px; flex-grow: 1; max-width: 33%; }
.relic .skill-text { font-size: 11px; }

.sheet-row { flex-direction: row; }
.sheet-row > .btn, .sheet-row > Button { flex-grow: 1; flex-basis: 0; margin-right: 6px; }

.village-code { font-size: 18px; color: #2b2215; -unity-font-definition: resource("UI/Fonts/PermanentMarker"); -unity-text-align: middle-center; white-space: normal; }
.code-input { flex-grow: 2; font-size: 16px; margin-right: 6px; }
.code-note { white-space: normal; -unity-text-align: middle-center; }
.wrap { white-space: normal; }
.sheet-row > .plain { font-size: 13px; }

/* ---------- folding things away (owner 2026-10-14) ---------- */
.bar { overflow: visible; }
.drawer-toggle {
    position: absolute; top: -26px; align-self: center; height: 26px; padding: 0 14px; font-size: 12px;
    color: #f6e7c4; background-color: rgba(58, 42, 24, 0.92); border-width: 0; border-top-left-radius: 8px; border-top-right-radius: 8px;
    -unity-font-definition: resource("UI/Fonts/ImFellEnglishSC");
}
.errand-fold { position: absolute; right: 2px; top: 0; width: 26px; height: 22px; font-size: 16px; padding: 0; background-color: rgba(0, 0, 0, 0); border-width: 0; color: #7a5a2a; }
.errand-note.folded { width: auto; padding: 4px 10px; }
.errand-note.folded .errand-heading { font-size: 12px; }
