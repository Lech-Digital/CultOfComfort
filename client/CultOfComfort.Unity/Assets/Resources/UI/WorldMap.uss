/* The Marchlands (spec 2026-10-14 world map): a parchment map over the village. */
.world-map { position: absolute; left: 8px; right: 8px; top: 8%; bottom: 3%; padding: 10px 12px; flex-direction: column; }
.map-header { flex-direction: row; justify-content: space-between; align-items: center; }
/* The title gives way (ellipsis) so the zoom, help and close buttons are always on screen. Plain Fell: the small-caps
   face mangles some letter pairs ("Th", "no"). */
.map-title {
    font-size: 17px; -unity-font-definition: resource("UI/Fonts/ImFellEnglish"); color: #3a2a18; -unity-font-style: bold;
    flex-shrink: 1; flex-grow: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; padding: 0; margin: 0;
}
.map-close { font-size: 18px; width: 36px; height: 36px; flex-shrink: 0; padding: 0; margin: 0 0 0 2px; background-color: rgba(0, 0, 0, 0); border-width: 0; color: #3a2a18; }
.map-help-line { font-size: 11px; color: #6b5238; }
.map-tension { margin: 2px 0 4px 0; }
.map-tension-bar { height: 8px; background-color: rgba(58, 42, 24, 0.2); border-radius: 4px; margin: 3px 0; }
.map-tension-fill { height: 8px; background-color: #a8322a; border-radius: 4px; width: 0; }
.map-line { font-size: 12px; color: #3a2a18; white-space: normal; padding: 0; margin: 0; }
.map-row { flex-direction: row; align-items: center; }
.map-small-button { font-size: 12px; padding: 3px 10px; margin: 2px 0 2px 6px; align-self: flex-end; }
.map-area { flex-grow: 1; margin: 4px 0; background-color: rgba(120, 96, 60, 0.12); border-radius: 8px; overflow: hidden; }
.map-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.map-node-holder { position: absolute; width: 104px; height: 82px; align-items: center; }
.map-ring { position: absolute; top: 0; left: 26px; width: 52px; height: 52px; }
.map-node {
    position: absolute; top: 5px; left: 31px; width: 42px; height: 42px; border-radius: 21px; padding: 0; margin: 0;
    background-color: #f1e3c0; border-width: 1px; border-color: #6b5238; align-items: center; justify-content: center;
}
.map-node-home { background-color: #ffe7a8; }
.map-node-icon { width: 30px; height: 30px; }
.map-node-share { position: absolute; bottom: -6px; font-size: 9px; color: #3a2a18; background-color: rgba(241, 227, 192, 0.9); padding: 0 3px; border-radius: 3px; }
.map-node-name { position: absolute; top: 53px; left: 17px; width: 70px; font-size: 8px; color: #3a2a18; -unity-text-align: upper-center; white-space: normal; background-color: rgba(241, 227, 192, 0.75); border-radius: 3px; }
.map-node-far { opacity: 0.45; }
.map-banner { display: none; position: absolute; top: -10px; right: -6px; width: 12px; height: 16px; background-color: #46618c; border-width: 1px; border-color: #2b2215; }
.map-node-patron > .map-banner { display: flex; }
.map-walker { position: absolute; width: 18px; height: 18px; border-radius: 9px; background-color: #46618c; border-width: 2px; border-color: #ece6d6; }
.map-footer { padding-top: 4px; }
.map-sheet { position: absolute; left: 10px; right: 10px; bottom: 10px; max-height: 85%; }
.map-note { white-space: normal; margin-top: 4px; }
.icon-swords { background-image: resource("UI/Icons/swords"); }
.sheet-entry { flex-direction: row; align-items: center; padding: 4px 2px; border-bottom-width: 1px; border-color: rgba(107, 82, 56, 0.2); }
.sheet-heading { font-size: 15px; color: #3a2a18; -unity-font-definition: resource("UI/Fonts/ImFellEnglishSC"); margin-top: 8px; white-space: normal; }
.map-zoom { flex-direction: row; flex-grow: 0; flex-shrink: 0; justify-content: flex-end; }
.map-node-camp { background-color: #e3cfa6; border-width: 2px; border-color: #3a2a18; }
.icon-cult { background-image: resource("UI/Icons/cult"); }
.sheet-tabs { flex-direction: row; flex-wrap: wrap; margin: 4px 0 2px 0; border-bottom-width: 2px; border-color: rgba(107, 82, 56, 0.35); }
.sheet-tab { font-size: 13px; padding: 5px 9px; margin: 0 4px -2px 0; background-color: rgba(120, 96, 60, 0.12); color: #3a2a18;
    border-width: 1px 1px 0 1px; border-color: rgba(107, 82, 56, 0.35); border-top-left-radius: 6px; border-top-right-radius: 6px;
    border-bottom-left-radius: 0; border-bottom-right-radius: 0; -unity-font-definition: resource("UI/Fonts/ImFellEnglishSC"); }
.sheet-tab-open { background-color: #f1e3c0; border-color: #6b5238; border-bottom-width: 2px; border-bottom-color: #f1e3c0; -unity-font-style: bold; }
.sheet-scroll { margin-top: 2px; }
/* The real map (spec 2026-10-15): the land fills the screen; panels at the top and bottom, plates over the places. */
.world-map-3d { position: absolute; left: 0; right: 0; top: 0; bottom: 0; flex-direction: column; }
.map-top { padding: 8px 12px 6px 12px; margin: 0 6px; }
.map-bottom { padding: 8px 12px; margin: 0 6px; }
.map-status { align-self: center; margin-top: 10px; padding: 4px 10px; font-size: 13px; color: #3a2a18; background-color: rgba(241, 227, 192, 0.85); border-radius: 6px; display: none; }
.map-plate { position: absolute; flex-direction: row; align-items: center; translate: -50% -100%; padding: 0; margin: 0; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.map-plate-ring { width: 26px; height: 26px; border-radius: 13px; background-color: rgba(241, 227, 192, 0.92); align-items: center; justify-content: center; margin-right: -4px; }
.map-plate-share { font-size: 8px; color: #3a2a18; padding: 0; margin: 0; -unity-font-style: bold; }
.map-plate-name {
    font-size: 10px; color: #3a2a18; padding: 1px 6px 1px 7px; margin: 0; background-color: rgba(241, 227, 192, 0.92); border-radius: 4px;
    border-width: 0 0 2px 0; border-color: rgba(107, 82, 56, 0.6); white-space: nowrap; -unity-font-style: bold;
}
.map-plate-home > .map-plate-name { background-color: #ffe7a8; border-color: #46618c; font-size: 11px; }
.map-plate-camp > .map-plate-name { background-color: rgba(227, 207, 166, 0.95); border-width: 0 0 3px 0; }
.map-plate-far { opacity: 0.6; }
.map-plate-quiet > .map-plate-name { display: none; }
.map-plate-selected > .map-plate-name { background-color: #ffe7a8; border-color: #e8a54b; }
.map-plate-patron > .map-banner { display: flex; }
.map-plate > .map-banner { top: -12px; right: -8px; }
.map-plate-seat > .map-plate-name { background-color: #3a2a18; color: #f1e3c0; border-color: #a8322a; font-size: 11px; }
/* Tithes at the seat, missionaries on a roster (spec 2026-10-15). */
.map-chip { flex-direction: row; justify-content: flex-start; padding: 4px 8px; margin: 0 0 4px 0; }
.map-chip > .map-line { -unity-text-align: middle-left; }
.map-roster-row { flex-direction: column; align-items: stretch; padding: 6px 10px; margin: 3px 0; height: auto; min-height: 36px; }
.map-roster-title { font-size: 14px; color: #3a2a18; -unity-font-style: bold; -unity-text-align: middle-left; white-space: normal; }
.map-roster-bar { height: 6px; background-color: rgba(58, 42, 24, 0.2); border-radius: 3px; margin-top: 3px; }
.map-roster-fill { height: 6px; background-color: #46618c; border-radius: 3px; width: 0; }
.map-roster-row > .small { -unity-text-align: middle-left; white-space: normal; }
/* The minimap and the Home button (owner 2026-10-15: "go back home… a minimap in the corner"). */
.map-mini-row { flex-direction: row; justify-content: flex-end; margin: 6px 10px 0 0; }
.map-minimap {
    width: 104px; height: 104px; border-radius: 52px; border-width: 3px; border-color: #6b5238; overflow: hidden;
    background-color: #5f8f99; -unity-background-scale-mode: stretch-to-fill;
}
.map-home-row { flex-direction: row; justify-content: flex-end; margin: 0 10px 6px 0; }
.map-go-home {
    flex-direction: row; align-items: center; height: 40px; padding: 0 12px 0 6px; margin: 0; border-radius: 20px;
    background-color: #f1e3c0; border-width: 2px; border-color: #6b5238;
}
.map-go-home-icon { width: 30px; height: 30px; margin: 0; padding: 0; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.map-go-home-text { font-size: 14px; color: #3a2a18; -unity-font-style: bold; margin: 0 0 0 2px; padding: 0; }
/* The lord's demand and the Mission House (spec 2026-10-15). */
.map-demand { margin-top: 4px; padding: 4px 6px; background-color: rgba(168, 50, 42, 0.12); border-radius: 6px; border-width: 1px; border-color: rgba(168, 50, 42, 0.5); }
.map-demand-line { font-size: 11px; color: #5a1f18; }
.map-card-demand { padding: 6px 8px; margin: 2px 0 6px 0; background-color: rgba(168, 50, 42, 0.12); border-radius: 6px; border-width: 1px; border-color: rgba(168, 50, 42, 0.5); }
.map-card-preachers { flex-direction: row; flex-wrap: wrap; margin: 4px 0 0 0; }
.map-preacher-chip { font-size: 12px; padding: 4px 8px; margin: 2px 4px 2px 0; border-radius: 12px; background-color: rgba(120, 96, 60, 0.12); border-width: 1px; border-color: #8a6a3a; color: #3a2a18; }
.map-preacher-chip-on { background-color: #46618c; color: #f1e3c0; border-color: #2b3d5c; }
.house-intro { margin: 2px 0 6px 0; }
.house-card { padding: 8px 10px; margin: 4px 0; border-radius: 8px; border-width: 1px; border-color: rgba(107, 82, 56, 0.45); background-color: rgba(255, 248, 230, 0.5); }
.house-portrait { width: 44px; height: 44px; border-radius: 22px; margin-right: 8px; align-items: center; justify-content: center; border-width: 2px; border-color: #3a2a18; }
.house-portrait-home { background-color: #46618c; }
.house-portrait-out { background-color: #8a6a43; }
.house-initial { font-size: 22px; color: #f1e3c0; -unity-font-style: bold; margin: 0; padding: 0; }
.house-name { font-size: 16px; color: #3a2a18; -unity-font-style: bold; margin: 0; padding: 0; }
.house-xp-fill { height: 6px; background-color: #d9b45a; border-radius: 3px; width: 0; }
.house-report { font-size: 12px; margin-top: 3px; }
/* The mission board (spec 2026-10-16): tales, preachers, places, without the map. */
.house-title { font-size: 19px; }
.house-status { font-size: 13px; margin-top: 4px; }
.house-small-button { height: 30px; font-size: 13px; margin-top: 4px; }
.house-map-button { height: 32px; font-size: 13px; margin-top: 10px; }
.house-tale { padding: 8px 10px; margin: 4px 0 6px 0; border-radius: 8px; background-image: resource("UI/Kit/note_yellow");
    -unity-slice-left: 16; -unity-slice-right: 16; -unity-slice-top: 16; -unity-slice-bottom: 16; rotate: -0.6deg; }
.house-tale-teller { font-size: 11px; color: #7a5a2a; -unity-font-definition: resource("UI/Fonts/ImFellEnglishSC"); padding: 0; margin: 0; }
.house-tale-text { font-size: 15px; color: #2b2215; margin: 2px 0 2px 0; padding: 0; -unity-font-definition: resource("UI/Fonts/PermanentMarker"); }
.house-tale-choice { height: auto; min-height: 34px; white-space: normal; font-size: 13px; margin-top: 5px; padding: 4px 8px; background-color: rgba(255, 250, 235, 0.65); }
.house-place { padding: 7px 9px; margin: 3px 0; border-radius: 8px; border-width: 1px; border-color: rgba(107, 82, 56, 0.35); background-color: rgba(255, 248, 230, 0.45); }
.house-place-open { border-color: #6b5238; border-width: 2px; background-color: rgba(255, 248, 230, 0.85); }
.house-place-far { opacity: 0.5; }
.house-place-icon { width: 30px; height: 30px; margin-right: 8px; }
.house-place-name { font-size: 15px; color: #3a2a18; -unity-font-style: bold; margin: 0; padding: 0; }
.house-place-share { font-size: 15px; color: #3a2a18; -unity-font-style: bold; margin-left: 6px; -unity-text-align: middle-right; }
.house-faith { flex-direction: row; margin-top: 5px; }
.house-faith-mine { height: 6px; background-color: #d9a520; border-top-left-radius: 3px; border-bottom-left-radius: 3px; }
.house-faith-rival { height: 6px; background-color: #a8322a; }
.house-preach { height: 38px; font-size: 14px; margin-top: 5px; background-color: rgba(70, 97, 140, 0.14); border-color: #46618c; }
/* The lord's hall (spec 2026-10-16). */
.hall-throne { flex-direction: row; align-items: center; margin: 4px 0 8px 0; padding: 8px; border-radius: 10px; background-color: rgba(122, 31, 26, 0.10); }
.hall-face { width: 96px; height: 96px; border-radius: 48px; border-width: 4px; border-color: #d9b45a; background-color: #6d4c2f; overflow: hidden; flex-shrink: 0; }
.hall-face-art { width: 100%; height: 100%; }
.hall-mood-1 { border-color: #d98a38; }
.hall-mood-2 { border-color: #c0392b; background-color: #8a3a2a; }
.hall-mood-3 { border-color: #7a1f1a; background-color: #a8322a; scale: 1.04 1.04; }
.hall-words { flex-grow: 1; flex-shrink: 1; margin-left: 10px; }
.hall-mood { font-size: 15px; color: #7a1f1a; -unity-font-style: bold; padding: 0; margin: 0; white-space: normal; }
.hall-speech { font-size: 14px; color: #3a2a18; margin-top: 4px; padding: 0; -unity-font-style: italic; }
.hall-paper { padding: 10px 12px 10px 12px; margin: 4px 0; border-radius: 4px; background-color: #f8edd0; border-width: 1px; border-color: #b39b6b; rotate: 0.5deg; }
.hall-seal { position: absolute; right: 8px; top: -8px; width: 26px; height: 26px; border-radius: 13px; background-color: #a8322a; border-width: 2px; border-color: #7a1f1a; }
.hall-letter-text { font-size: 15px; color: #2b2215; margin: 0 22px 4px 0; padding: 0; -unity-font-style: italic; }
.hall-deliver { height: 46px; font-size: 17px; margin-top: 8px; background-color: #c97a2c; color: #fff4dc; border-color: #6b3a12; border-width: 2px; -unity-font-definition: resource("UI/Fonts/ImFellEnglishSC"); }
.hall-deliver:disabled { opacity: 0.5; }
.hall-or { margin-top: 8px; }
.hall-plea { height: 36px; font-size: 14px; margin-top: 4px; }
.hall-note { margin: 1px 0 0 4px; }
.hall-tithe { height: auto; min-height: 36px; white-space: normal; font-size: 13px; padding: 4px 8px; }
.icon-portrait_lord { background-image: resource("UI/Icons/portrait_lord"); }
